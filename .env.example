# Copy to .env.local and fill in the values printed by `supabase start`.
# Never commit .env.local - see .gitignore.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-me

# FR-028: how long an invitation or password-reset code stays redeemable.
# 72 hours is long enough to span a weekend between two classroom sessions.
VITE_INVITATION_TTL_HOURS=72
