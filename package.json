{
  "name": "ml4g-xai-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Explainable AI Lab for the Technovation program - capture, train and explain an image classifier entirely on the learner's device",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ml": "vitest run tests/unit --environment node",
    "test:i18n": "vitest run tests/unit/i18n.test.ts",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "test:e2e:nowebgl": "NO_WEBGL=1 playwright test --project=chromium-nowebgl",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:network": "playwright test tests/e2e/network.spec.ts",
    "fetch:backbone": "node scripts/fetch-backbone.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.5",
    "@fontsource/rubik": "^5.2.5",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.74.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "dexie": "^4.0.11",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-router": "^7.5.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
